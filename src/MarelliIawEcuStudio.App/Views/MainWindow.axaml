<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MarelliIawEcuStudio.Presentation.ViewModels"
        xmlns:views="using:MarelliIawEcuStudio.App.Views"
        xmlns:defs="using:MarelliIawEcuStudio.Core.Definitions"
        x:Class="MarelliIawEcuStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="{Binding Ui[AppTitle]}"
        Width="1180" Height="780" MinWidth="900" MinHeight="600">

  <Window.DataTemplates>
    <DataTemplate x:DataType="vm:DashboardGroupViewModel">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="cardTitle" Text="{Binding Title}" />
          <ItemsControl ItemsSource="{Binding Gauges}" IsVisible="{Binding HasGauges}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ParameterRowViewModel">
                <StackPanel Width="176" Margin="0,0,6,4">
                  <views:ArcGauge Height="140" Value="{Binding NumericValue}" Minimum="{Binding Display.Min}" Maximum="{Binding Display.Max}"
                                  Zones="{Binding Display.Zones}" ValueText="{Binding ValueText}" Unit="{Binding Unit}" />
                  <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Text="{Binding Name}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Bars}" IsVisible="{Binding HasBars}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ParameterRowViewModel">
                <Grid ColumnDefinitions="1.3*,*,Auto" ColumnSpacing="10" Margin="0,3">
                  <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                  <views:LinearGauge Grid.Column="1" Height="14" VerticalAlignment="Center" Value="{Binding NumericValue}" Minimum="{Binding Display.Min}"
                                     Maximum="{Binding Display.Max}" Center="{Binding Display.Center}" Zones="{Binding Display.Zones}" />
                  <TextBlock Grid.Column="2" MinWidth="84" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center">
                    <Run Classes="dashValue" Text="{Binding ValueText}" />
                    <Run Classes="subtle" FontSize="11" Text="{Binding Unit}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding HasValues}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ParameterRowViewModel">
                <Border Classes="tile" Width="150">
                  <StackPanel>
                    <TextBlock Classes="subtle" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                               Height="28" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                    <TextBlock>
                      <Run Classes="dashValue" FontSize="16" Text="{Binding ValueText}" />
                      <Run Classes="subtle" FontSize="11" Text="{Binding Unit}" />
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Leds}" IsVisible="{Binding HasLeds}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><views:BalancedColumns MinColumnWidth="300" MaxColumns="3" ColumnSpacing="12" RowSpacing="0" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ParameterRowViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3">
                  <Border Classes="led" Classes.on="{Binding IsOn}" Classes.ledWarning="{Binding IsLedWarning}" Classes.ledInfo="{Binding IsLedInfo}" />
                  <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>

    <!-- Connection bar -->
    <Border DockPanel.Dock="Top" Classes="toolbar bar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,2*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Classes="label" Text="{Binding Ui[Interface]}" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}"
                  SelectedItem="{Binding SelectedTarget}" IsEnabled="{Binding IsDisconnected}" />
        <Button Grid.Column="2" Content="{Binding Ui[Refresh]}" Command="{Binding RefreshTargetsCommand}"
                IsEnabled="{Binding IsDisconnected}" />
        <TextBlock Grid.Column="3" Classes="label" Margin="12,0,0,0" Text="{Binding Ui[Ecu]}" />
        <Grid Grid.Column="4" ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <TextBox x:Name="EcuSearch" Width="190" Text="{Binding EcuFilter}" PlaceholderText="{Binding Ui[EcuSearch]}"
                   IsEnabled="{Binding IsDisconnected}" ToolTip.Tip="{Binding Ui[EcuSearch]}" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FilteredEcus}"
                    SelectedItem="{Binding SelectedEcu}" IsEnabled="{Binding IsDisconnected}"
                    ToolTip.Tip="{Binding SelectedEcu.Subtitle}">
            <!-- One line in the box, so it is as tall as the other controls; two lines in the list. -->
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:EcuChoice">
                <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                  <Run Text="{Binding Name}" />
                  <Run Classes="subtle" FontSize="12" Text="{Binding Subtitle}" />
                </TextBlock>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EcuChoice">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="subtle" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
          <Button Classes="accent" Content="{Binding Ui[Connect]}" Command="{Binding ConnectCommand}"
                  IsVisible="{Binding IsDisconnected}" MinWidth="110" HotKey="F10" />
          <Button Content="{Binding Ui[Cancel]}" Command="{Binding CancelConnectCommand}"
                  IsVisible="{Binding IsConnecting}" MinWidth="110" HotKey="Escape" />
          <Button Content="{Binding Ui[Reconnect]}" Command="{Binding ReconnectCommand}"
                  IsVisible="{Binding IsLost}" HotKey="F12" />
          <Button Content="{Binding Ui[Disconnect]}" Command="{Binding DisconnectCommand}"
                  IsVisible="{Binding IsOnline}" MinWidth="110" />
        </StackPanel>
        <!-- Theme: shows the current choice; the menu offers the three. -->
        <Button Grid.Column="6" x:Name="ThemeButton" Padding="8,0" ToolTip.Tip="{Binding ThemeToolTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Panel Width="16" Height="16">
              <PathIcon Width="16" Height="16" IsVisible="{Binding IsThemeSystem}"
                        Data="F0 M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,4 A8,8 0 0 0 12,20 Z" />
              <PathIcon Width="16" Height="16" IsVisible="{Binding IsThemeLight}"
                        Data="M12,7 A5,5 0 1 1 11.99,7 Z M11,1 H13 V4 H11 Z M11,20 H13 V23 H11 Z M1,11 H4 V13 H1 Z M20,11 H23 V13 H20 Z M4.2,5.6 L5.6,4.2 L7.7,6.3 L6.3,7.7 Z M16.3,17.7 L17.7,16.3 L19.8,18.4 L18.4,19.8 Z M4.2,18.4 L6.3,16.3 L7.7,17.7 L5.6,19.8 Z M16.3,6.3 L18.4,4.2 L19.8,5.6 L17.7,7.7 Z" />
              <PathIcon Width="16" Height="16" IsVisible="{Binding IsThemeDark}"
                        Data="M21,12.8 A9,9 0 1 1 11.2,3 A7,7 0 0 0 21,12.8 Z" />
            </Panel>
            <TextBlock VerticalAlignment="Center" Text="{Binding SelectedTheme.Name}" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{Binding Ui[Theme_system]}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                        Command="{Binding SelectThemeCommand}" CommandParameter="system" />
              <MenuItem Header="{Binding Ui[Theme_light]}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                        Command="{Binding SelectThemeCommand}" CommandParameter="light" />
              <MenuItem Header="{Binding Ui[Theme_dark]}" ToggleType="Radio" GroupName="theme" IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                        Command="{Binding SelectThemeCommand}" CommandParameter="dark" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="7" Content="{Binding Ui[Options]}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <!-- Scrolls on a short screen; long texts wrap instead of being cut. -->
              <ScrollViewer MaxHeight="{Binding #Root.Bounds.Height, Converter={x:Static views:Converters.OptionsHeight}}">
                <StackPanel Spacing="8" Width="400" Classes="options">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="{Binding Ui[Language]}" />
                      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="label" Text="{Binding Ui[Theme]}" />
                      <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" />
                    </StackPanel>
                  </Grid>
                  <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding ListenForIsoBroadcast}"><TextBlock TextWrapping="Wrap" MaxWidth="356" Text="{Binding Ui[WaitBroadcast]}" /></CheckBox>
                  <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding Compatibility}"><TextBlock TextWrapping="Wrap" MaxWidth="356" Text="{Binding Ui[CompatMode]}" /></CheckBox>
                  <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding DtrEnable}"><TextBlock TextWrapping="Wrap" MaxWidth="356" Text="{Binding Ui[Dtr]}" /></CheckBox>
                  <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding AllowActiveCommands}"><TextBlock TextWrapping="Wrap" MaxWidth="356" Text="{Binding Ui[AllowActive]}" /></CheckBox>
                  <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding AutoReconnect}"><TextBlock TextWrapping="Wrap" MaxWidth="356" Text="{Binding Ui[AutoReconnect]}" /></CheckBox>
                  <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding TraceLine}"><TextBlock TextWrapping="Wrap" MaxWidth="356" Text="{Binding Ui[TraceLine]}" /></CheckBox>
                  <TextBlock Classes="label" TextWrapping="Wrap" Text="{Binding Ui[BridgeAddress]}" />
                  <TextBox Text="{Binding BridgeAddress}" PlaceholderText="192.168.4.1:2217" />
                  <TextBlock Classes="label" Text="{Binding Ui[LogFolder]}" />
                  <TextBox Text="{Binding LogFolder}" />
                </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Port hint (e.g. FTDI latency) -->
    <Border DockPanel.Dock="Top" Classes="hint" IsVisible="{Binding TargetHint, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding TargetHint}" TextWrapping="Wrap" />
    </Border>

    <!-- Connected ECU: one line; the vehicle name gives way first on a narrow window. -->
    <Border DockPanel.Dock="Top" Classes="toolbar" IsVisible="{Binding IsOnline}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="20">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="{Binding Ui[Ecu]}" />
          <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding EcuName}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="{Binding Ui[IsoCode]}" />
          <TextBlock Classes="value" FontSize="13" Text="{Binding Iso}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="{Binding Ui[Codric]}" />
          <TextBlock Classes="value" FontSize="13" Text="{Binding Codric}" />
        </StackPanel>
        <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="6" ClipToBounds="True">
          <TextBlock Classes="label" Text="{Binding Ui[Vehicle]}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Vehicle}" ToolTip.Tip="{Binding Vehicle}" />
        </Grid>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="{Binding Ui[Immobilizer]}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding Immobilizer}" />
        </StackPanel>
        <Border Grid.Column="5" Classes="badge" IsVisible="{Binding IsSimulation}">
          <TextBlock FontWeight="SemiBold" Text="{Binding Ui[Simulation]}" />
        </Border>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="8,4">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="label" Text="{Binding RecordingText}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
        <TextBlock Grid.Column="2" Classes="label" Text="{Binding RateText}" IsVisible="{Binding IsOnline}" />
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Padding="0">

      <!-- Dashboard -->
      <TabItem x:Name="DashboardTab" Header="{Binding Ui[TabDashboard]}">
        <ScrollViewer Background="{DynamicResource PageBackgroundBrush}">
          <views:FitToViewport x:Name="DashboardFit" MinScale="0.8" MaxScale="1.5">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="10">
            <StackPanel Spacing="10">
              <Border Classes="card" IsVisible="{Binding VehicleInfo.HasInfo}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="cardTitle" Text="{Binding Ui[VehicleCard]}" />
                  <StackPanel IsVisible="{Binding IsOnline}" Spacing="2">
                    <TextBlock Classes="label" Text="{Binding Ui[DetectedVehicle]}" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding VehicleInfo.DetectedVehicle}"
                               Classes.invalid="{Binding !VehicleInfo.IsDetected}" />
                  </StackPanel>
                  <TextBlock FontWeight="SemiBold" Margin="0,4,0,0" Text="{Binding VehicleInfo.EcuName}" />
                  <TextBlock Classes="label" TextWrapping="Wrap" Text="{Binding VehicleInfo.Technology}" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding VehicleInfo.AliasesText}"
                             IsVisible="{Binding VehicleInfo.AliasesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="{Binding Ui[Period]}" />
                    <TextBlock Text="{Binding VehicleInfo.Period}" />
                  </StackPanel>
                  <Expander HorizontalAlignment="Stretch" Margin="0,6,0,0">
                    <Expander.Header>
                      <TextBlock TextWrapping="Wrap" Text="{Binding VehicleInfo.CompatibilityCaption}" />
                    </Expander.Header>
                    <StackPanel Spacing="6">
                      <ItemsControl ItemsSource="{Binding VehicleInfo.Brands}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:BrandVehiclesViewModel">
                            <StackPanel Margin="0,0,0,6">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Brand}" />
                              <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="defs:CompatibleVehicle">
                                    <TextBlock TextWrapping="Wrap" Margin="12,1,0,0">
                                      <Run Text="{Binding Model}" />
                                      <Run Text="  " />
                                      <Run Classes="subtle" Text="{Binding Engines}" />
                                    </TextBlock>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="label" TextWrapping="Wrap" Text="{Binding VehicleInfo.Notes}" />
                      <TextBlock Classes="header" Text="{Binding Ui[IsoVehicles]}" />
                      <ItemsControl ItemsSource="{Binding VehicleInfo.IsoVehicles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Margin="12,1,0,0" Text="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding DashboardLeft}" IsVisible="{Binding IsOnline}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="10" IsVisible="{Binding IsOnline}">
              <ItemsControl ItemsSource="{Binding DashboardRightPair}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding DashboardRight}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Grid>
          </views:FitToViewport>
        </ScrollViewer>
      </TabItem>

      <!-- Parameters -->
      <TabItem Header="{Binding Ui[TabParameters]}" IsEnabled="{Binding IsOnline}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding Ui[SelectAll]}" Command="{Binding SelectAllCommand}" />
              <Button Content="{Binding Ui[SelectNone]}" Command="{Binding SelectNoneCommand}" />
              <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" Margin="16,0,0,0" />
            </StackPanel>
          </Border>
          <ScrollViewer>
            <views:FitToViewport x:Name="ParametersFit" MinScale="0.9" MaxScale="1.3">
              <ItemsControl ItemsSource="{Binding ParameterGroups}" Margin="8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <views:BalancedColumns MinColumnWidth="540" MaxColumns="3" ColumnSpacing="16" RowSpacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DashboardGroupViewModel">
                    <StackPanel>
                      <!-- The group title doubles as the column header, so headers line up in every column. -->
                      <Border Classes="groupHeader">
                        <Grid ColumnDefinitions="48,56,*,96,56">
                          <TextBlock Classes="header" FontWeight="Normal" FontSize="11"
                                     Text="{Binding #Root.((vm:MainViewModel)DataContext).Ui[ColRead]}" />
                          <TextBlock Grid.Column="1" Classes="header" FontWeight="Normal" FontSize="11"
                                     Text="{Binding #Root.((vm:MainViewModel)DataContext).Ui[ColPlot]}" />
                          <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Text="{Binding Title}" />
                          <TextBlock Grid.Column="3" Classes="header" FontWeight="Normal" FontSize="11" HorizontalAlignment="Right"
                                     Text="{Binding #Root.((vm:MainViewModel)DataContext).Ui[ColValue]}" />
                          <TextBlock Grid.Column="4" Classes="header" FontWeight="Normal" FontSize="11" Margin="8,0,0,0"
                                     Text="{Binding #Root.((vm:MainViewModel)DataContext).Ui[ColUnit]}" />
                        </Grid>
                      </Border>
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ParameterRowViewModel">
                            <Border Classes="compactRow">
                              <Grid ColumnDefinitions="48,56,*,96,56">
                                <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding IsSelected}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsPlotted}" />
                                <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Grid.Column="3" Classes="value" FontSize="14" Classes.invalid="{Binding !IsValid}"
                                           HorizontalAlignment="Right" Text="{Binding ValueText}" />
                                <TextBlock Grid.Column="4" Classes="label" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Unit}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </views:FitToViewport>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Errors -->
      <TabItem Header="{Binding Ui[TabErrors]}" IsEnabled="{Binding IsOnline}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <CheckBox Content="{Binding Ui[ReadErrors]}" IsChecked="{Binding ReadErrors}" />
              <Button Content="{Binding Ui[ClearCodes]}" Command="{Binding ClearCodesCommand}" />
              <TextBlock Classes="label" Text="{Binding Ui[StatusLegend]}" />
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Top" Padding="8,6,8,4">
            <Grid ColumnDefinitions="*,90,*">
              <TextBlock Classes="header" Text="{Binding Ui[ColName]}" />
              <TextBlock Grid.Column="1" Classes="header" Text="{Binding Ui[ColStatus]}" />
              <TextBlock Grid.Column="2" Classes="header" Text="{Binding Ui[ColReason]}" />
            </Grid>
          </Border>
          <Panel>
            <TextBlock Classes="label" Margin="12" VerticalAlignment="Top" Text="{Binding Ui[NoErrors]}" IsVisible="{Binding !HasErrors}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ErrorRowViewModel">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,90,*">
                        <TextBlock Classes.active="{Binding IsActive}" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Classes="value" FontSize="13" Classes.active="{Binding IsActive}" Text="{Binding Status}" />
                        <TextBlock Grid.Column="2" Text="{Binding Reason}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </TabItem>

      <!-- Actuator tests -->
      <TabItem Header="{Binding Ui[TabTests]}" IsEnabled="{Binding IsOnline}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="8,8,8,4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,220,110,110,120">
              <TextBlock Classes="header" Text="{Binding Ui[ColName]}" />
              <TextBlock Grid.Column="1" Classes="header" Text="{Binding Ui[ColCondition]}" />
              <TextBlock Grid.Column="2" Classes="header" Text="{Binding Ui[ColDuration]}" />
              <TextBlock Grid.Column="4" Classes="header" Margin="8,0,0,0" Text="{Binding Ui[ColResult]}" />
            </Grid>
          </Border>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tests}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActiveItemViewModel">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,220,110,110,120">
                      <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="label" TextTrimming="CharacterEllipsis" Text="{Binding Condition}" />
                      <TextBlock Grid.Column="2" Classes="label" Text="{Binding Detail}" />
                      <Button Grid.Column="3" Content="{Binding #Root.((vm:MainViewModel)DataContext).Ui[Run]}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).RunTestCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Result}"
                                 Classes.passed="{Binding IsPassed}" Classes.failed="{Binding IsFailed}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Adjustments -->
      <TabItem Header="{Binding Ui[TabAdjustments]}" IsEnabled="{Binding IsOnline}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="8,8,8,4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,220,110,110,120">
              <TextBlock Classes="header" Text="{Binding Ui[ColName]}" />
              <TextBlock Grid.Column="1" Classes="header" Text="{Binding Ui[ColCondition]}" />
              <TextBlock Grid.Column="2" Classes="header" Text="{Binding Ui[ColType]}" />
              <TextBlock Grid.Column="4" Classes="header" Margin="8,0,0,0" Text="{Binding Ui[ColResult]}" />
            </Grid>
          </Border>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Adjustments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActiveItemViewModel">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,220,110,110,120">
                      <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="label" TextTrimming="CharacterEllipsis" Text="{Binding Condition}" />
                      <TextBlock Grid.Column="2" Classes="label" Text="{Binding Detail}" />
                      <Button Grid.Column="3" Content="{Binding #Root.((vm:MainViewModel)DataContext).Ui[Apply]}"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).RunAdjustmentCommand}"
                              CommandParameter="{Binding}" />
                      <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Result}"
                                 Classes.passed="{Binding IsPassed}" Classes.failed="{Binding IsFailed}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Live graphs -->
      <TabItem Header="{Binding Ui[TabGraphs]}" IsEnabled="{Binding IsOnline}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <CheckBox Content="{Binding Ui[SeparateScales]}" IsChecked="{Binding Graph.SeparateScales}" />
              <CheckBox Content="{Binding Ui[Follow]}" IsChecked="{Binding Graph.Follow}" />
              <TextBlock Classes="label" Text="{Binding Ui[Window]}" />
              <ComboBox ItemsSource="{x:Static vm:GraphViewModel.WindowChoices}" SelectedItem="{Binding Graph.WindowSecondsChoice}" x:Name="WindowCombo">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:Int32">
                    <TextBlock Text="{Binding StringFormat='{}{0} s'}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{Binding Ui[ClearGraph]}" Command="{Binding Graph.ClearCommand}" />
              <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" />
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Bottom" Classes="label" Margin="8,4" TextWrapping="Wrap" Text="{Binding Ui[GraphHint]}" />
          <views:PlotView x:Name="LivePlot" Source="{Binding Graph}" />
        </DockPanel>
      </TabItem>

      <!-- Log replay -->
      <TabItem x:Name="ReplayTab" Header="{Binding Ui[TabReplay]}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="toolbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
              <Button Content="{Binding Ui[OpenLog]}" Command="{Binding Replay.OpenCommand}" />
              <Button Grid.Column="1" Classes="accent" MinWidth="90" Content="{Binding Replay.PlayPauseText}"
                      Command="{Binding Replay.TogglePlayCommand}" IsEnabled="{Binding Replay.IsLoaded}" />
              <TextBlock Grid.Column="2" Classes="label" Text="{Binding Ui[Speed]}" />
              <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:ReplayViewModel.SpeedChoices}" SelectedItem="{Binding Replay.Speed}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:Double">
                    <TextBlock Text="{Binding StringFormat='{}{0}x'}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Grid.Column="4" Content="{Binding Ui[SeparateScales]}" IsChecked="{Binding Replay.SeparateScales}" />
              <TextBlock Grid.Column="5" Classes="label" HorizontalAlignment="Right" Text="{Binding Replay.FileName}" />
            </Grid>
          </Border>
          <Border DockPanel.Dock="Top" Padding="8,4" IsVisible="{Binding Replay.IsLoaded}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <Slider Minimum="0" Maximum="{Binding Replay.DurationMs}" Value="{Binding Replay.PositionMs}" />
              <TextBlock Grid.Column="1" Classes="value" FontSize="13" VerticalAlignment="Center" Text="{Binding Replay.PositionText}" />
            </Grid>
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="label" Margin="8,0,8,4" Text="{Binding Replay.Summary}" IsVisible="{Binding Replay.IsLoaded}" />
          <Panel>
            <TextBlock Classes="label" Margin="16" Text="{Binding Ui[ReplayEmpty]}" IsVisible="{Binding !Replay.IsLoaded}" />
            <Grid ColumnDefinitions="340,*" IsVisible="{Binding Replay.IsLoaded}">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Replay.Columns}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReplayColumnViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="40,*,80,50">
                          <CheckBox HorizontalAlignment="Stretch" IsChecked="{Binding IsPlotted}" />
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Grid.Column="2" Classes="value" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ValueText}" />
                          <TextBlock Grid.Column="3" Classes="label" Margin="6,0,0,0" Text="{Binding Unit}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <views:PlotView Grid.Column="1" x:Name="ReplayPlot" Source="{Binding Replay}" />
            </Grid>
          </Panel>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
