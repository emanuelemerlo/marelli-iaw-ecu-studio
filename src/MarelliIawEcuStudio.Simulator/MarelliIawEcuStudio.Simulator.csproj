<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MarelliIawEcuStudio.Simulator</RootNamespace>
    <Description>Simulated ECUs behind an ITransport: IAW units driven by the Core definition files, OBD-II cars on a framed K-Line, and replay of recorded line traces. For tests and demos without a car.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarelliIawEcuStudio.Core\MarelliIawEcuStudio.Core.csproj" />
  </ItemGroup>

</Project>
