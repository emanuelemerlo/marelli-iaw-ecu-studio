  <PropertyGroup>
    <RootNamespace>MarelliIawEcuStudio.Transport.Network</RootNamespace>
    <Description>Network transport for K-Line adapters: RFC 2217 (Telnet COM port control) client and server, compatible with ser2net and esp-link.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
